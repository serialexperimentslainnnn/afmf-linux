// afmf-linux: 2x2 box downsample of the new frame for half-resolution optical flow.
//
// Sampling with a linear filter exactly at the centre of each 2x2 source quad averages the four
// texels; the result feeds the FidelityFX luma pass, which only needs RGB. Runs on the layer's
// compute queue, unlike vkCmdBlitImage, which needs a graphics queue.

#version 450

#ifndef AFMF_OUT_FORMAT
#define AFMF_OUT_FORMAT rgba8
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_src;
layout(set = 0, binding = 1, AFMF_OUT_FORMAT) uniform image2D u_dst;

layout(push_constant) uniform Params {
    ivec2 size; // destination size in pixels
} p;

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= p.size.x || pix.y >= p.size.y)
        return;
    vec2 uv = (vec2(pix) + 0.5) / vec2(p.size);
    imageStore(u_dst, pix, texture(u_src, uv));
}
