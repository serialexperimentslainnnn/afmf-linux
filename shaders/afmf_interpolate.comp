// afmf-linux: frame interpolation from colour + FidelityFX optical flow.
//
// For every output pixel y the block motion v (prev = cur + v, in pixels) says where the content
// at y sits in each real frame at the midpoint: cur(y - v/2) and prev(y + v/2). Both are fetched
// with bilinear filtering and averaged. When the scene change detector fired, or the motion is
// beyond what the flow can track, the pixel falls back to the configured fast-motion response:
// repeat the previous frame or blend the two without motion.
//
// Compiled once per output format: AFMF_OUT_FORMAT in {rgba8, rgb10_a2, rgba16f}; AFMF_SWAP_RB=1
// writes .bgra so a raw copy into a B8G8R8A8 swapchain image lands in the right channels.
// AFMF_OUT_FORMAT_NONE=1 leaves the storage image unqualified (needs the device feature
// shaderStorageImageWriteWithoutFormat): for writing straight into a B8G8R8A8 swapchain image.

#version 450
#extension GL_EXT_samplerless_texture_functions : require

#ifndef AFMF_OUT_FORMAT
#define AFMF_OUT_FORMAT rgba8
#endif
#ifndef AFMF_OUT_FORMAT_NONE
#define AFMF_OUT_FORMAT_NONE 0
#endif
#ifndef AFMF_SWAP_RB
#define AFMF_SWAP_RB 0
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_prev;
layout(set = 0, binding = 1) uniform sampler2D u_cur;
layout(set = 0, binding = 2) uniform itexture2D u_flow;      // rg16i, one texel per 8x8 block
layout(set = 0, binding = 3, r32ui) uniform uimage2D u_scd;  // FidelityFX SCD output, 3 slots
#if AFMF_OUT_FORMAT_NONE
layout(set = 0, binding = 4) writeonly uniform image2D u_out;
#else
layout(set = 0, binding = 4, AFMF_OUT_FORMAT) uniform image2D u_out;
#endif

layout(push_constant) uniform Params {
    ivec2 size;          // output size in pixels
    int block;           // optical flow block size (8), in flow-resolution pixels
    int fallback;        // 0 repeat previous frame, 1 blend without motion
    float max_motion;    // |v| above which the flow is not trusted, in output pixels
    float flow_scale;    // output pixels per flow-resolution pixel (1 or 2)
    float hud_threshold; // a pixel equal in both frames within this, on a moving block, is HUD: kept as is (0 = off)
} p;

const int SCD_SCENE_CHANGE_SLOT = 0;
const int SCD_HISTORY_BITS_SLOT = 1;

// Blocks whose vectors differ by more than this (flow pixels, squared) are two objects, not one
// surface: interpolating between them gives a vector that is right for neither.
const float FLOW_EDGE_SQ = 36.0;

float dist_sq(vec2 a, vec2 b)
{
    vec2 d = a - b;
    return dot(d, d);
}

// Flow at pixel y, bilinearly interpolated between the four nearest block centres so the field
// has no 8-pixel steps, except across a motion edge (the silhouette of a pillar against a
// background moving past it), where the nearest block's own vector is used: a vector halfway
// between an object and its background warps both wrongly and draws a halo.
vec2 flow_at(vec2 y)
{
    vec2 b = y / (float(p.block) * p.flow_scale) - 0.5;
    ivec2 b0 = ivec2(floor(b));
    vec2 f = b - vec2(b0);
    ivec2 last = textureSize(u_flow, 0) - 1;
    ivec2 b1 = min(b0 + 1, last);
    b0 = max(b0, ivec2(0));
    vec2 v00 = vec2(texelFetch(u_flow, ivec2(b0.x, b0.y), 0).xy);
    vec2 v10 = vec2(texelFetch(u_flow, ivec2(b1.x, b0.y), 0).xy);
    vec2 v01 = vec2(texelFetch(u_flow, ivec2(b0.x, b1.y), 0).xy);
    vec2 v11 = vec2(texelFetch(u_flow, ivec2(b1.x, b1.y), 0).xy);
    float spread = max(max(dist_sq(v00, v10), dist_sq(v01, v11)),
                       max(dist_sq(v00, v01), dist_sq(v10, v11)));
    if (spread > FLOW_EDGE_SQ) {
        vec2 nearest = f.x < 0.5 ? (f.y < 0.5 ? v00 : v01) : (f.y < 0.5 ? v10 : v11);
        return nearest * p.flow_scale;
    }
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y) * p.flow_scale;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= p.size.x || pix.y >= p.size.y)
        return;

    vec2 inv_size = 1.0 / vec2(p.size);
    vec2 y = vec2(pix) + 0.5;

    bool scene_changed = (imageLoad(u_scd, ivec2(SCD_HISTORY_BITS_SLOT, 0)).x & 1u) != 0u;
    vec2 v = flow_at(y);
    bool trusted = !scene_changed && dot(v, v) <= p.max_motion * p.max_motion;

    vec4 colour;
    if (trusted && p.hud_threshold > 0.0 && dot(v, v) > 0.0) {
        // A static overlay over motion (HUD, crosshair, subtitles): the pixel itself did not
        // change between the frames although its block moved. Warping it would drag the
        // background's motion into the overlay; keeping it is right. A flat interior that moved
        // meets the same test and gets the same value either way. What it cannot tell apart is
        // an object narrower than its own motion per frame, which then goes missing in between.
        vec4 at_cur = texelFetch(u_cur, pix, 0);
        vec4 at_prev = texelFetch(u_prev, pix, 0);
        vec3 diff = abs(at_cur.rgb - at_prev.rgb);
        if (max(diff.r, max(diff.g, diff.b)) <= p.hud_threshold) {
#if AFMF_SWAP_RB
            at_cur = at_cur.bgra;
#endif
            imageStore(u_out, pix, at_cur);
            return;
        }
    }
    if (trusted) {
        vec2 half_v = 0.5 * v;
        vec4 from_cur = texture(u_cur, (y - half_v) * inv_size);
        vec4 from_prev = texture(u_prev, (y + half_v) * inv_size);
        // The two warps agree where the vector is right and the content exists in both
        // frames; where they disagree (a wrong vector, or a background uncovered from behind
        // a passing object, which only one frame holds) averaging them draws both, a double
        // image. The blend then leans on the newer frame, which is what shows next anyway.
        // Measured relative to the local level so HDR values are judged the same way.
        vec3 diff = abs(from_cur.rgb - from_prev.rgb);
        float level = 0.5 * (dot(from_cur.rgb, vec3(1.0 / 3.0)) + dot(from_prev.rgb, vec3(1.0 / 3.0)));
        float disagreement = max(diff.r, max(diff.g, diff.b)) / (level + 0.05);
        float newer = smoothstep(0.15, 0.6, disagreement);
        colour = mix(0.5 * (from_cur + from_prev), from_cur, newer);
    } else if (p.fallback == 1) {
        colour = 0.5 * (texture(u_cur, y * inv_size) + texture(u_prev, y * inv_size));
    } else {
        colour = texture(u_prev, y * inv_size);
    }

#if AFMF_SWAP_RB
    colour = colour.bgra;
#endif
    imageStore(u_out, pix, colour);
}
